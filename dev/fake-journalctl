#!/usr/bin/env bash
# Stand-in for journalctl when developing without systemd: prints a few made-up lines.
#
#   JOURNALCTL=dev/fake-journalctl node server.js
set -euo pipefail

unit=unknown
lines=10
follow=
while [ $# -gt 0 ]; do
  case "$1" in
    -u) unit="$2"; shift ;;
    -n) lines="$2"; shift ;;
    -f | --follow) follow=1 ;;
  esac
  shift
done

for i in $(seq "$(( lines < 25 ? lines : 25 ))" -1 1); do
  printf '%s devbox %s[%d]: fake log line %d for %s\n' \
    "$(date -v-"${i}"M +%Y-%m-%dT%H:%M:%S%z 2>/dev/null || date -d "-$i min" +%Y-%m-%dT%H:%M:%S%z)" \
    "${unit%.service}" 4242 "$i" "$unit"
done

# With --follow, keep printing a line every few seconds until killed.
n=0
while [ -n "$follow" ]; do
  sleep 3
  n=$((n + 1))
  printf '%s devbox %s[%d]: fake live line %d\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "${unit%.service}" 4242 "$n"
done
