# Copy to .env (ignored by git) for local settings; server.js reads it on start.
# Variables already set in the environment win. On the server, settings live in
# /etc/mkd-dashboard.env instead (written by setup.sh).

# Admin password for the login page. `npm run dev` uses "dev" unless set here.
# ADMIN_PASSWORD=

# Tailnet domain, used in apps.json as ${TAILNET}.
# TAILNET=your-tailnet.ts.net

# Push alerts: ntfy and/or Telegram.
# NTFY_URL=https://ntfy.sh/some-long-random-topic
# NTFY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Other settings (defaults shown).
# PORT=8090
# HOST=127.0.0.1
# CONFIG_PATH=./apps.json
# FILES_ROOT=/
